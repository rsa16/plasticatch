# Public Supabase settings. Copy to `.env` and fill in from the Supabase dashboard.
#
# These are the *publishable* project URL and anon/publishable key. They are safe
# to ship in a client bundle. Never put a service-role key in a file named
# EXPO_PUBLIC_*: Expo inlines those into the JavaScript bundle.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public Mapbox token for the Map tab. Create one at https://account.mapbox.com/.
# Without it the Map tab shows a setup state instead of crashing. Never put a secret
# download token here: `EXPO_PUBLIC_*` values are inlined into the client bundle.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Published support and Privacy Policy destinations shown in Settings. Leave unset until
# they are provisioned: Settings hides the row rather than showing a dead link. The Privacy
# URL must be an absolute https:// URL. No legal copy lives in the client.
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_PRIVACY_URL=

# Which photo check the Catch flow uses: "claude" calls the verification Edge Function,
# anything else (or unset) keeps the 50% coin flip. Leave unset until the function below is
# deployed and its secret is set; otherwise every capture fails with "Couldn't check your photo".
EXPO_PUBLIC_CATCH_VERIFIER=

# The Anthropic key is NOT read from this file. It is a Supabase Edge Function secret:
#   npx supabase secrets set ANTHROPIC_API_KEY=... --project-ref rivfogygicrhkpfkwmlu
